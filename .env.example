# Copy to .env (git ignored) and change the values. Never commit .env.

# App database
POSTGRES_DB=kmicro
POSTGRES_USER=kmicro
POSTGRES_PASSWORD=change-me
# Host port (default 55432, so it does not clash with a Postgres already on your machine)
POSTGRES_PORT=55432

# Keycloak admin console and Keycloak's own database
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me

# Meilisearch (at least 16 characters)
MEILI_MASTER_KEY=change-me-to-a-long-random-key

# Redis auth (optional locally, leave empty for no password; required later)
REDIS_PASSWORD=
# Host port (default 56379, so it does not clash with a Redis already on your machine)
REDIS_PORT=56379
